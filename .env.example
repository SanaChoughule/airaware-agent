# AirAware Environment Configuration (.env.example)

# Google AI Gemini API Key (Optional in Demo Mode - deterministic engine activates if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Google Maps & Air Quality API Keys (Optional in Demo Mode)
GOOGLE_AIR_QUALITY_API_KEY=
GOOGLE_MAPS_API_KEY=

# AirAware Operational Flags
AIRAWARE_DEMO_MODE=true
SERVER_PORT=8080
